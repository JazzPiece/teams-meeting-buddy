{
  "manifest_version": 3,
  "name": "Teams Transcript Exporter",
  "version": "1.3.0",
  "description": "Export Teams meeting transcripts as VTT, SRT, DOCX or compact AI text. Dark mode, copy to clipboard, Alt+Shift+T shortcut.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "export-transcript": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" },
      "description": "Export transcript with current settings"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "teams-transcript-exporter@local",
      "strict_min_version": "128.0"
    }
  }
}
